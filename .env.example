# --- LLM (requerido para el reporte generado) ---
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar para el reporte. Default: claude-opus-4-8
SELVORO_MODEL=claude-opus-4-8

# --- Mercado Libre (opcional en el MVP) ---
# Si no tenés app registrada, el collector intenta el endpoint público y degrada
# con gracia si ML pide autenticación. Cuando registres la app, completá esto.
# https://developers.mercadolibre.com.ar/
ML_ACCESS_TOKEN=

# Site de Mercado Libre a consultar. MLA = Argentina (default).
ML_SITE_ID=MLA

# --- Meta Ad Library (opcional en el MVP) ---
# Requiere: app en Meta for Developers + producto "Ads Library API" + permiso
# ads_read aprobado vía App Review + verificación de negocio de la organización.
# Sin este token, el collector degrada con gracia: persistencia publicitaria y
# saturación local quedan con confianza baja, igual que Mercado Libre sin token.
# Recomendado: system user token con scope ads_archive (no expira, rotable).
# https://developers.facebook.com/docs/marketing-api/ad-library-api
META_ADS_ACCESS_TOKEN=

# Versión de la Graph API a usar (formato vXX.0). Default en el collector: v21.0.
# Solo hace falta setear esto si Meta deprecó esa versión.
META_GRAPH_API_VERSION=

# --- Base de datos (Postgres, cualquier proveedor — Neon es gratis y sin setup) ---
# DATABASE_URL: conexión pooled, la usa la app en runtime.
# DIRECT_URL: conexión directa, la usa Prisma para migrar (algunos proveedores
# no la necesitan; si tu Postgres no distingue, usá el mismo valor en ambas).
DATABASE_URL=
DIRECT_URL=

# --- Auth (Clerk) ---
# https://dashboard.clerk.com -> creá una app -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# --- Cron de reconciliación de suscripciones ---
CRON_SECRET=

# --- Chat (agente conversacional) ---
# Techo de tokens por turno agéntico (Task Budget de Anthropic). Evita que un
# turno con varias tool calls encadenadas (ej. search_products) escale sin
# control. Mínimo permitido por la API: 20000. Default en el código: 50000.
CHAT_TASK_BUDGET_TOKENS=
