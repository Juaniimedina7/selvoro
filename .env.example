# --- LLM (requerido para el reporte generado) ---
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar para el reporte. Default: claude-opus-4-8
SELVORO_MODEL=claude-opus-4-8

# --- Mercado Libre (opcional en el MVP) ---
# Si no tenés app registrada, el collector intenta el endpoint público y degrada
# con gracia si ML pide autenticación. Cuando registres la app, completá esto.
# https://developers.mercadolibre.com.ar/
ML_ACCESS_TOKEN=

# Site de Mercado Libre a consultar. MLA = Argentina (default).
ML_SITE_ID=MLA

# --- Meta Ad Library ---
# El access token YA NO es server-side: cada usuario lo carga desde
# Configuración -> Integraciones en la UI (BYOK, guardado cifrado en DB).
# Requiere: app en Meta for Developers + producto "Ads Library API" + permiso
# ads_read aprobado vía App Review + verificación de negocio de la organización.
# https://developers.facebook.com/docs/marketing-api/ad-library-api

# Versión de la Graph API a usar (formato vXX.0). Default en el collector: v21.0.
# Esta sí es server-side (no es secreta, es un pin de versión de API).
META_GRAPH_API_VERSION=

# --- Cifrado de credenciales de usuario (BYOK) ---
# Generar con: openssl rand -base64 32
# Si se pierde/rota sin migrar, las credenciales ya guardadas quedan
# ilegibles (hay que volver a cargarlas). También firma el `state` del
# flujo OAuth de las integraciones de abajo (HMAC, no hace falta otra key).
CREDENTIALS_ENCRYPTION_KEY=

# --- Tienda Nube (BYOK, OAuth) ---
# Registrate como partner en dev.tiendanube.com, creá una app y configurá su
# URL de redirect a <tu dominio>/api/settings/credentials/tienda_nube/callback.
# App "independiente" (NO hace falta NubeSDK, eso es solo para apps
# embebidas en el admin de Tienda Nube).
TIENDANUBE_CLIENT_ID=
TIENDANUBE_CLIENT_SECRET=

# --- Mercado Libre como vendedor (BYOK, OAuth) ---
# Distinto de ML_ACCESS_TOKEN de arriba (esa es para la búsqueda pública,
# compartida). Esta es para que cada usuario conecte SU cuenta vendedora.
# Registrá una app en developers.mercadolibre.com.ar, redirect a
# <tu dominio>/api/settings/credentials/mercadolibre_seller/callback.
MERCADOLIBRE_SELLER_CLIENT_ID=
MERCADOLIBRE_SELLER_CLIENT_SECRET=

# --- BuiltWith (server-side, no BYOK) ---
# Stack tecnológico de un dominio (competidor). Gratis, registro en
# builtwith.com. No es dato personal del usuario, por eso es compartida.
BUILTWITH_API_KEY=

# --- Base de datos (Postgres, cualquier proveedor — Neon es gratis y sin setup) ---
# DATABASE_URL: conexión pooled, la usa la app en runtime.
# DIRECT_URL: conexión directa (sin pooler), la usa Prisma para migrar.
# SHADOW_DATABASE_URL: una DB VACÍA Y DEDICADA (no la misma que las de arriba)
# que `prisma migrate dev` usa como scratch space para diffear migraciones.
# Con Neon: creá otra DB en el mismo proyecto (mismo host/usuario, distinto
# nombre) y apuntá acá, ej. .../prisma_shadow?sslmode=require.
DATABASE_URL=
DIRECT_URL=
SHADOW_DATABASE_URL=

# --- Auth (Clerk) ---
# https://dashboard.clerk.com -> creá una app -> API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Mercado Pago ---
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=

# --- Cron de reconciliación de suscripciones ---
CRON_SECRET=

# --- Chat (agente conversacional) ---
# Techo de tokens por turno agéntico (Task Budget de Anthropic). Evita que un
# turno con varias tool calls encadenadas (ej. search_products) escale sin
# control. Mínimo permitido por la API: 20000. Default en el código: 28000
# (bajado para mitigar el límite duro de 60s de Vercel Hobby, ver chat.ts).
CHAT_TASK_BUDGET_TOKENS=
