// Schema de negocio de Selvoro. La identidad del usuario vive en Clerk
// (@clerk/nextjs) — estas tablas solo guardan estado de facturación y
// reportes, referenciando usuarios por clerkUserId (string), sin tabla
// User local para evitar desincronización con Clerk.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Plan {
  id                  String   @id @default(cuid())
  code                String   @unique // "starter" | "pro" | "agencia"
  name                String
  priceArs            Decimal  @db.Decimal(10, 2)
  monthlyCredits      Int
  mpPreapprovalPlanId String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Subscription {
  id                 String             @id @default(cuid())
  clerkUserId        String
  planId              String
  plan                Plan               @relation(fields: [planId], references: [id])
  status              SubscriptionStatus @default(PENDING)
  mpPreapprovalId     String             @unique
  mpPayerId           String?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  creditsRemaining    Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  creditEvents CreditLedger[]
  reports      Report[]

  @@index([clerkUserId, status])
}

enum CreditEventType {
  GRANT
  DEBIT
  REFUND
  ADJUSTMENT
}

model CreditLedger {
  id             String          @id @default(cuid())
  clerkUserId    String
  subscriptionId String?
  subscription   Subscription?   @relation(fields: [subscriptionId], references: [id])
  type           CreditEventType
  amount         Int // con signo: + para GRANT/REFUND, - para DEBIT
  reason         String // "monthly_reset" | "analysis:<reportId>" | "analysis:failed" | "manual_adjustment"
  reportId       String?
  createdAt      DateTime        @default(now())

  @@index([clerkUserId, createdAt])
}

model Report {
  id             String        @id @default(cuid())
  clerkUserId    String
  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  query          String
  ticketUsd      Decimal?      @db.Decimal(10, 2)
  verdict        String
  confidence     String
  compositeScore Int
  payload        Json
  createdAt      DateTime      @default(now())

  @@index([clerkUserId, createdAt])
}

/**
 * Credenciales de integraciones de datos cargadas por el usuario (BYOK) —
 * NUNCA las de IA (ANTHROPIC_API_KEY sigue siendo server-side) ni ML_ACCESS_TOKEN
 * (excluido a propósito, sigue compartido). `provider` es String libre (no
 * enum) para que sumar una integración nueva sea una entrada de código, sin
 * migración de schema. `encryptedValue` es un JSON cifrado (AES-256-GCM) con
 * forma libre por provider (hoy meta_ads: {"accessToken": "..."}).
 */
model UserCredential {
  id             String   @id @default(cuid())
  clerkUserId    String
  provider       String
  encryptedValue String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([clerkUserId, provider])
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

model WebhookEvent {
  id          String        @id @default(cuid())
  provider    String        @default("mercadopago")
  externalId  String        @unique
  type        String
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  processedAt DateTime?
  createdAt   DateTime      @default(now())
}

enum AgentRunKind {
  ANALYZE
  COMPARE
  SEARCH
}

enum AgentRunSource {
  CHAT
  MCP
}

/// Persiste analyze_product / compare_markets / search_products disparados
/// desde el chat o el MCP (Report solo guarda corridas del formulario web,
/// con narrativa). payload guarda el objeto de dominio completo según kind:
/// AnalysisEvidence (ANALYZE), MarketComparison (COMPARE) o
/// SearchProductsResult sin resumir (SEARCH). verdict/confidence/compositeScore
/// quedan null para COMPARE; para SEARCH se denormaliza el mejor candidato.
model AgentRun {
  id             String         @id @default(cuid())
  clerkUserId    String
  kind           AgentRunKind
  source         AgentRunSource
  query          String
  market         String?
  ticketUsd      Decimal?       @db.Decimal(10, 2)
  verdict        String?
  confidence     String?
  compositeScore Int?
  payload        Json
  createdAt      DateTime       @default(now())

  @@index([clerkUserId, createdAt])
}

/// Conversaciones de chat multi-hilo. messages guarda el array completo
/// {role, content}[] tal como lo maneja ChatWindow.tsx — un solo Json,
/// mismo criterio que Report.payload. No se normaliza a una tabla de
/// mensajes: el cliente ya reenvía el array completo en cada POST, y el
/// volumen esperado (chat personal, no message board) no justifica el
/// costo de una tabla hija.
model Conversation {
  id          String   @id @default(cuid())
  clerkUserId String
  title       String?
  messages    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clerkUserId, updatedAt])
}
